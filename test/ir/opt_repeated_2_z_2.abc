// TEST: T0185
// ARGS: -O2 -Oz -O2
// FUNCTION: keep
// SIZE-ATTRIBUTES: none
// OPTIMIZED: yes
// Repeated options: the last one (-O2) wins.
// The last optimization option takes precedence (regression test for #0034).

extern fn keep(x: int): int;

fn keep(x: int): int
{
    local y: int = x * 2;
    return y + 1;
}
