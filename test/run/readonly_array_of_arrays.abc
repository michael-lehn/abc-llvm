// TEST: T0210
// XFAIL: #0037
// Readonly arrays whose element type is an array.  Creating the readonly
// element type while the set of array types is searched recurses endlessly.
// Whether the recursion is reached depends on the order of addresses in the
// compiler's heap; 64 declarations crash every build of the compiler tested
// (LLVM 17 to 23; builds with LLVM 17 to 20 need more than 16).

global r1: readonly array[1] of array[1] of int;
global r2: readonly array[1] of array[2] of int;
global r3: readonly array[1] of array[3] of int;
global r4: readonly array[1] of array[4] of int;
