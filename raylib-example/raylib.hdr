@define PI 3.14159265358979323846float
@define DEG2RAD (PI/180.0float)




struct Vector2 {
    x: float;
    y: float;
};

// Vector3, 3 components
struct Vector3 {
    x: float;
    y: float;
    z: float;
};

// Vector4, 4 components
struct Vector4 {
    x: float;
    y: float;
    z: float;
    w: float;
};

// Matrix, 4x4 components, column major, OpenGL style, right-handed
struct Matrix {
    m0, m4, m8, m12: float;
    m1, m5, m9, m13: float;
    m2, m6, m10, m14: float;
    m3, m7, m11, m15: float;
};

// Quaternion, 4 components (Vector4 alias)
type Quaternion: Vector4;

struct Color
{
    r, g, b, a: u8;
};

@define LIGHTGRAY  Color{ 200, 200, 200, 255 }
@define GRAY       Color{ 130, 130, 130, 255 }
@define DARKGRAY   Color{ 80, 80, 80, 255 }
@define YELLOW     Color{ 253, 249, 0, 255 }
@define GOLD       Color{ 255, 203, 0, 255 }
@define ORANGE     Color{ 255, 161, 0, 255 }
@define PINK       Color{ 255, 109, 194, 255 }
@define RED        Color{ 230, 41, 55, 255 }
@define MAROON     Color{ 190, 33, 55, 255 }
@define GREEN      Color{ 0, 228, 48, 255 }
@define LIME       Color{ 0, 158, 47, 255 }
@define DARKGREEN  Color{ 0, 117, 44, 255 }
@define SKYBLUE    Color{ 102, 191, 255, 255 }
@define BLUE       Color{ 0, 121, 241, 255 }
@define DARKBLUE   Color{ 0, 82, 172, 255 }
@define PURPLE     Color{ 200, 122, 255, 255 }
@define VIOLET     Color{ 135, 60, 190, 255 }
@define DARKPURPLE Color{ 112, 31, 126, 255 }
@define BEIGE      Color{ 211, 176, 131, 255 }
@define BROWN      Color{ 127, 106, 79, 255 }
@define DARKBROWN  Color{ 76, 63, 47, 255 }

@define WHITE      Color{ 255, 255, 255, 255 }
@define BLACK      Color{ 0, 0, 0, 255 }
@define BLANK      Color{ 0, 0, 0, 0 }
@define MAGENTA    Color{ 255, 0, 255, 255 }

@define RAYWHITE   Color{ 245, 245, 245, 255 }

struct Rectangle {
    x, y, width, height: float;
};

// Image, pixel data stored in CPU memory (RAM)
struct Image {
    data: ->void;
    width, height, mipmaps, format: int;
};

// Texture, tex data stored in GPU memory (VRAM)
struct Texture {
    id: unsigned;
    width, height, mipmaps, format: int;
};

// Texture2D, same as Texture
type Texture2D: Texture;

// TextureCubemap, same as Texture
type TextureCubemap: Texture;

// RenderTexture, fbo for texture rendering
struct RenderTexture {
    id: unsigned;
    texture, depth: Texture;
};

// RenderTexture2D, same as RenderTexture
type RenderTexture2D: RenderTexture;

// NPatchInfo, n-patch layout info
struct NPatchInfo {
    source: Rectangle;
    left, top, right, bottom, layout: int;
};

// GlyphInfo, font characters glyphs info
struct GlyphInfo {
    value, offsetX, offsetY, advanceX: int;
    image: Image;
};

// Font, font texture and GlyphInfo array data
struct Font {
    baseSize, glyphCount, glyphPadding: int;
    texture: Texture2D;
    recs: -> Rectangle;
    glyphs: ->GlyphInfo;
};

// Camera, defines position/orientation in 3d space
struct Camera3D {
    position, target, up: Vector3;
    fovy: float;
    projection: int;
};

type Camera: Camera3D;

// Camera2D, defines position/orientation in 2d space
struct Camera2D {
    offset, target: Vector2;
    rotation, zoom: float;
};

// Mesh, vertex data and vao/vbo
struct Mesh {
    vertexCount, triangleCount: int;

    // Vertex attributes data
    vertices, texcoords, texcoords2, normals, tangents: ->float;
    colors: ->u8;
    indices: ->ushort;

    // Skin data for animation
    boneCount: int;
    boneIndices: ->u8;
    boneWeights: ->float;

    // Runtime animation vertex data (CPU skinning)
    // NOTE: In case of GPU skinning, not used, pointers are NULL
    animVertices: ->float;
    animNormals: ->float;

    // OpenGL identifiers
    vaoId: unsigned;
    vboId: ->int;
};

// Shader
struct Shader {
    id: unsigned;
    locs: ->int;
};

// MaterialMap
struct MaterialMap {
    texture: Texture2D;
    color: Color;
    value: float;
};

// Material, includes shader and maps
struct Material {
    shader: Shader;
    maps: ->MaterialMap;
    params: array[4] of float;
};

// Transform, vertex transformation data
struct Transform {
    translation: Vector3;
    rotation: Quaternion;
    scale: Vector3;
};

// Anim pose, an array of Transform[]
type ModelAnimPose: ->Transform;

// Bone, skeletal animation bone
struct BoneInfo {
    name: array[32] of char;
    parent: int;
};

// Skeleton, animation bones hierarchy
struct ModelSkeleton {
    boneCount: int;
    bones: ->BoneInfo;
    bindPose: ModelAnimPose;
};

// Model, meshes, materials and animation data
struct Model {
    transform: Matrix;

    meshCount, materialCount: int;
    meshes: ->Mesh;
    materials: ->Material;
    meshMaterial: ->int;

    // Animation data
    skeleton: ModelSkeleton;

    // Runtime animation data (CPU/GPU skinning)
    currentPose: ModelAnimPose;
    boneMatrices: ->Matrix;
};

// ModelAnimation, contains a full animation sequence
struct ModelAnimation {
    name: array[32] of char;

    boneCount, keyframeCount: int;
    keyframePoses: ->ModelAnimPose;
};

// Ray, ray for raycasting
struct Ray {
    position, direction: Vector3;
};

// RayCollision, ray hit information
struct RayCollision {
    hit: bool;
    distance: float;
    point, normal: Vector3;
};

// BoundingBox
struct BoundingBox {
    min, max: Vector3;
};

// Wave, audio wave data
struct Wave {
    frameCount, sampleRate, sampleSize, channels: unsigned;
    data: ->void;
};

// Opaque structs declaration
// NOTE: Actual structs are defined internally in raudio module
struct rAudioBuffer;
struct rAudioProcessor;

// AudioStream, custom audio stream
struct AudioStream {
    buffer: ->rAudioBuffer;
    processor: ->rAudioProcessor;

    sampleRate, sampleSize, channels: unsigned;
};

// Sound
struct Sound {
    stream: AudioStream;
    frameCount: unsigned;
};

// Music, audio stream, anything longer than ~10 seconds should be streamed
struct Music {
    stream: AudioStream;
    frameCount: unsigned;
    looping: bool;

    ctxType: int;
    ctxData: ->void;
};

// VrDeviceInfo, Head-Mounted-Display device parameters
struct VrDeviceInfo {
    hResolution, vResolution: int;
    hScreenSize: float;
    vScreenSize: float;
    eyeToScreenDistance: float;
    lensSeparationDistance: float;
    interpupillaryDistance: float;
    lensDistortionValues: array[4] of float;
    chromaAbCorrection: array[4] of float;
};

// VrStereoConfig, VR stereo rendering configuration for simulator
struct VrStereoConfig
{
    projection: array[2] of Matrix;
    viewOffset: array[2] of Matrix;
    leftLensCenter: array[2] of float;
    rightLensCenter: array[2] of float;
    leftScreenCenter: array[2] of float;
    rightScreenCenter: array[2] of float;
    scale: array[2] of float;
    scaleIn: array[2] of float;
};

// File path list
struct FilePathList {
    count: unsigned;
    paths: ->->char;
};

// Automation event
struct AutomationEvent {
    frame: unsigned;
    type_: unsigned;
    params: array[4] of int;
};

// Automation event list
struct AutomationEventList {
    capacity, count: unsigned;
    events: ->AutomationEvent;
};

//----------------------------------------------------------------------------------
// Enumerators Definition
//----------------------------------------------------------------------------------
// System/Window config flags
// NOTE: Every bit registers one state (use it with bit masks)
// By default all flags are set to 0
enum ConfigFlags {
    FLAG_VSYNC_HINT         = 0x00000040,   // Set to try enabling V-Sync on GPU
    FLAG_FULLSCREEN_MODE    = 0x00000002,   // Set to run program in fullscreen
    FLAG_WINDOW_RESIZABLE   = 0x00000004,   // Set to allow resizable window
    FLAG_WINDOW_UNDECORATED = 0x00000008,   // Set to disable window decoration (frame and buttons)
    FLAG_WINDOW_HIDDEN      = 0x00000080,   // Set to hide window
    FLAG_WINDOW_MINIMIZED   = 0x00000200,   // Set to minimize window (iconify)
    FLAG_WINDOW_MAXIMIZED   = 0x00000400,   // Set to maximize window (expanded to monitor)
    FLAG_WINDOW_UNFOCUSED   = 0x00000800,   // Set to window non focused
    FLAG_WINDOW_TOPMOST     = 0x00001000,   // Set to window always on top
    FLAG_WINDOW_ALWAYS_RUN  = 0x00000100,   // Set to allow windows running while minimized
    FLAG_WINDOW_TRANSPARENT = 0x00000010,   // Set to allow transparent framebuffer
    FLAG_WINDOW_HIGHDPI     = 0x00002000,   // Set to support HighDPI
    FLAG_WINDOW_MOUSE_PASSTHROUGH = 0x00004000, // Set to support mouse passthrough, only supported when FLAG_WINDOW_UNDECORATED
    FLAG_BORDERLESS_WINDOWED_MODE = 0x00008000, // Set to run program in borderless windowed mode
    FLAG_MSAA_4X_HINT       = 0x00000020,   // Set to try enabling MSAA 4X
    FLAG_INTERLACED_HINT    = 0x00010000    // Set to try enabling interlaced video format (for V3D)
};

// Trace log level
// NOTE: Organized by priority level
enum TraceLogLevel {
    LOG_ALL = 0,
    LOG_TRACE,
    LOG_DEBUG,
    LOG_INFO,
    LOG_WARNING,
    LOG_ERROR,
    LOG_FATAL,
    LOG_NONE,
};

// Keyboard keys (US keyboard layout)
// NOTE: Use GetKeyPressed() to allow redefining required keys for alternative
// layouts
enum KeyboardKey {
    KEY_NULL            = 0,        // Key: NULL, used for no key pressed
    // Alphanumeric keys
    KEY_APOSTROPHE      = 39,       // Key: '
    KEY_COMMA           = 44,       // Key: ,
    KEY_MINUS           = 45,       // Key: -
    KEY_PERIOD          = 46,       // Key: .
    KEY_SLASH           = 47,       // Key: /
    KEY_ZERO            = 48,       // Key: 0
    KEY_ONE             = 49,       // Key: 1
    KEY_TWO             = 50,       // Key: 2
    KEY_THREE           = 51,       // Key: 3
    KEY_FOUR            = 52,       // Key: 4
    KEY_FIVE            = 53,       // Key: 5
    KEY_SIX             = 54,       // Key: 6
    KEY_SEVEN           = 55,       // Key: 7
    KEY_EIGHT           = 56,       // Key: 8
    KEY_NINE            = 57,       // Key: 9
    KEY_SEMICOLON       = 59,       // Key: ;
    KEY_EQUAL           = 61,       // Key: =
