// TEST: T0176
// ARGS: -Os -O0
// FUNCTION: keep
// SIZE-ATTRIBUTES: none
// OPTIMIZED: no
// -O0 after -Os disables optimization.
// The last optimization option takes precedence (regression test for #0034).

extern fn keep(x: int): int;

fn keep(x: int): int
{
    local y: int = x * 2;
    return y + 1;
}
