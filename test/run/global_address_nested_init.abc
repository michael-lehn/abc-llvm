// TEST: T0244
// Addresses of global variables, array elements and functions in nested
// aggregate initializers (regression test for #0006).

fn inc(x: int): int
{
    return x + 1;
}

struct Pair
{
    p, q: -> int;
};

struct Outer
{
    tag: int;
    pair: array[2] of Pair;
    elem: -> int;
    fp: -> fn(:int): int;
};

global x, y: int = {10, 20};
global arr: array[3] of int = {1, 2, 3};

global o: Outer = {
    1,
    { {&x, &y}, {&y, &x} },
    &arr[2],
    &inc,
};

fn main(): int
{
    assert(*o.pair[0].p == 10);
    assert(*o.pair[0].q == 20);
    assert(*o.pair[1].p == 20);
    assert(*o.pair[1].q == 10);
    assert(*o.elem == 3);
    assert(o.fp->(1) == 2);
    return 0;
}
