// TEST: T0199
// ARGS: --emit-llvm %s -o %o -target aarch64-unknown-linux-gnu
// IR-MATCH: ^target triple = "aarch64-unknown-linux-gnu"$
// -target after the input file and -o: the triple is not an input file.

extern fn keep(x: int): int;

fn keep(x: int): int
{
    local y: int = x * 2;
    return y + 1;
}
