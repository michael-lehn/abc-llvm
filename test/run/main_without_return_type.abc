// TEST: T0252
// main without return type, verbatim program of HPC0 worksheet 7, step 5
// (regression test for #0069, expected output in
// main_without_return_type.out, cf. T0242).

@ <stdio.hdr>

struct Node
{
    val: array[8] of char;
    next: -> Node;
};

global a, b, c: Node = {
    {"world", &b},
    {"hello,", &c},
    {"!"},
};

fn main()
{
    for (local p: -> Node = &a; p; p = p->next) {
        printf("%s ", p->val);
    }
    printf("\n");
}
