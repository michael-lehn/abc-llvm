// TEST: T0021
// Global pointer initialized with the address of a global variable
// (regression test for #0006, cf. misc/global_ptr.abc).

global value: int = 42;
global arr: array[3] of int = {1, 2, 3};
global p: -> int = &value;
global q: -> int = &arr[1];

fn main(): int
{
    assert(*p == 42);
    assert(*q == 2);
    return 0;
}
