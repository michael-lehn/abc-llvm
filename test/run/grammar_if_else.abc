// TEST: T0030
// if statements: bodies are compound statements, 'else' is followed by a
// compound statement or another if statement.

fn classify(x: int): int
{
    if (x == 1) {
	return 1;
    } else if (x == 2) {
	return 2;
    } else {
	return 3;
    }
}

fn main(): int
{
    assert(classify(1) == 1 && classify(2) == 2 && classify(5) == 3);
    return 0;
}
