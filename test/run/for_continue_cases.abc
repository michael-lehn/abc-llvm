// TEST: T0284
// continue in a for loop runs the update expression exactly once, then checks
// the condition (issue #0002).

global updates: int = 0;

fn bump(): int
{
    updates++;
    return updates;
}

// every iteration runs the update exactly once
fn basic(): int
{
    local n: int = 0;
    for (local i: int = 0; i < 10; ++i) {
	if (i % 3 != 0) {
	    continue;
	}
	n++;
    }
    return n;
}

fn updateCount(): int
{
    updates = 0;
    for (local i: int = 0; i < 5; i = i + 1, bump()) {
	continue;
    }
    return updates;
}

fn nested(): int
{
    local n: int = 0;
    for (local i: int = 0; i < 3; ++i) {
	for (local j: int = 0; j < 3; ++j) {
	    if (j == 1) {
		continue;
	    }
	    n++;
	}
	if (i == 1) {
	    continue;
	}
	n += 10;
    }
    return n;
}

fn whileInFor(): int
{
    local n: int = 0;
    for (local i: int = 0; i < 3; ++i) {
	local k: int = 0;
	while (k < 3) {
	    ++k;
	    if (k == 2) {
		continue;
	    }
	    n++;
	}
	continue;
    }
    return n;
}

fn switchInFor(): int
{
    local n: int = 0;
    for (local i: int = 0; i < 4; ++i) {
	switch (i) {
	    case 1:
		continue;
	    case 2:
		break;
	    default:
		n += 10;
		break;
	}
	n++;
    }
    return n;
}

// no update expression
fn noUpdate(): int
{
    local i: int = 0;
    for (; i < 5;) {
	++i;
	continue;
    }
    return i;
}

fn noCondition(): int
{
    local i: int = 0;
    for (;; ++i) {
	if (i < 5) {
	    continue;
	}
	break;
    }
    return i;
}

fn bodyAlwaysReturns(): int
{
    for (local i: int = 0; i < 5; ++i) {
	return 7;
    }
    return 8;
}

fn bodyAlwaysBreaks(): int
{
    local i: int = 0;
    for (; i < 5; ++i) {
	break;
    }
    return i;
}

fn gotoInBody(): int
{
    local n: int = 0;
    for (local i: int = 0; i < 3; ++i) {
	if (i == 1) {
	    goto next;
	}
	n++;
label next:
	continue;
    }
    return n;
}

fn main(): int
{
    if (basic() != 4) {
	return 1;
    }
    if (updateCount() != 5) {
	return 2;
    }
    if (nested() != 26) {
	return 3;
    }
    if (whileInFor() != 6) {
	return 4;
    }
    if (switchInFor() != 23) {
	return 5;
    }
    if (noUpdate() != 5) {
	return 6;
    }
    if (noCondition() != 5) {
	return 7;
    }
    if (bodyAlwaysReturns() != 7) {
	return 8;
    }
    if (bodyAlwaysBreaks() != 0) {
	return 9;
    }
    if (gotoInBody() != 2) {
	return 10;
    }
    return 0;
}
