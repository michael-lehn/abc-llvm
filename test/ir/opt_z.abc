// TEST: T0170
// ARGS: -Oz
// FUNCTION: keep
// SIZE-ATTRIBUTES: optsize minsize
// OPTIMIZED: yes
// -Oz minimizes size (minsize implies optsize).
// The last optimization option takes precedence (regression test for #0034).

extern fn keep(x: int): int;

fn keep(x: int): int
{
    local y: int = x * 2;
    return y + 1;
}
