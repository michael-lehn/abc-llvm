// TEST: T0198
// ARGS: -target aarch64-unknown-linux-gnu
// IR-MATCH: ^target triple = "aarch64-unknown-linux-gnu"$
// IR-MATCH: ^target datalayout = "e-m:e-.*-n32:64
// -target sets the target triple and data layout of the module (AArch64).
// Generating IR for a target says nothing about its C ABI support.

extern fn keep(x: int): int;

fn keep(x: int): int
{
    local y: int = x * 2;
    return y + 1;
}
