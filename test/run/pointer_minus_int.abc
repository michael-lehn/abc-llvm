// TEST: T0048
// XFAIL: #0003 compiler crashes on pointer - integer (assertion in binaryexpr.cpp)
// Type checking accepts it, but code generation assumes pointer - pointer.

fn main(): int
{
    local a: array[5] of int = {10, 20, 30, 40, 50};
    local q: -> int = &a[4];
    assert(*(q - 3) == 20);
    return 0;
}
