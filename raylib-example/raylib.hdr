extern fn WaveCrop(wave: ->Wave, initFrame: int, finalFrame: int);
extern fn WaveFormat(wave: ->Wave, sampleRate: int, sampleSize: int,
		     channels: int);
extern fn LoadWaveSamples(wave: Wave): ->float;
extern fn UnloadWaveSamples(samples: ->float);

// Music management functions
extern fn LoadMusicStream(filename: ->readonly char): Music;
extern fn LoadMusicStreamFromMemory(fileType: ->readonly char,
				    data: ->readonly u8,
				    dataSize: int): Music;
extern fn IsMusicValid(music: Music): bool;
extern fn UnloadMusicStream(music: Music);
extern fn PlayMusicStream(music: Music);
extern fn IsMusicStreamPlaying(music: Music): bool;
extern fn UpdateMusicStream(music: Music);
extern fn StopMusicStream(music: Music);
extern fn PauseMusicStream(music: Music);
extern fn ResumeMusicStream(music: Music);
extern fn SeekMusicStream(music: Music, position: float);
extern fn SetMusicVolume(music: Music, volume: float);
extern fn SetMusicPitch(music: Music, pitch: float);
extern fn SetMusicPan(music: Music, pan: float);
extern fn GetMusicTimeLength(music: Music): float;
extern fn GetMusicTimePlayed(music: Music): float;

// AudioStream management functions
extern fn LoadAudioStream(sampleRate: unsigned, sampleSize: unsigned,
			  channels: unsigned): AudioStream;
extern fn IsAudioStreamValid(stream: AudioStream): bool;
extern fn UnloadAudioStream(stream: AudioStream);
extern fn UpdateAudioStream(stream: AudioStream, data: ->readonly void,
			    frameCount: int);
extern fn IsAudioStreamProcessed(stream: AudioStream): bool;
extern fn PlayAudioStream(stream: AudioStream);
extern fn PauseAudioStream(stream: AudioStream);
extern fn ResumeAudioStream(stream: AudioStream);
extern fn IsAudioStreamPlaying(stream: AudioStream): bool;
extern fn StopAudioStream(stream: AudioStream);
extern fn SetAudioStreamVolume(stream: AudioStream, volume: float);
extern fn SetAudioStreamPitch(stream: AudioStream, pitch: float);
extern fn SetAudioStreamPan(stream: AudioStream, pan: float);
extern fn SetAudioStreamBufferSizeDefault(size: int);
extern fn SetAudioStreamCallback(stream: AudioStream, callback: AudioCallback);

extern fn AttachAudioStreamProcessor(stream: AudioStream,
				     processor: AudioCallback);
extern fn DetachAudioStreamProcessor(stream: AudioStream,
				     processor: AudioCallback);

extern fn AttachAudioMixedProcessor(processor: AudioCallback);
extern fn DetachAudioMixedProcessor(processor: AudioCallback);
