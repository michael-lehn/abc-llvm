// TEST: T0174
// ARGS: -Oz -O2
// FUNCTION: keep
// SIZE-ATTRIBUTES: none
// OPTIMIZED: yes
// -O2 after -Oz optimizes for speed.
// The last optimization option takes precedence (regression test for #0034).

extern fn keep(x: int): int;

fn keep(x: int): int
{
    local y: int = x * 2;
    return y + 1;
}
