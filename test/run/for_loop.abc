// TEST: T0018
// for loops: local loop variable, expression lists, break, nested loops.

fn main(): int
{
    local sum: int = 0;
    for (local i: int = 1; i <= 10; ++i) {
	sum += i;
    }
    assert(sum == 55);

    // loop variable declared outside
    local j: int;
    for (j = 0; j < 5; j++) {
    }
    assert(j == 5);

    // expression lists in increment
    local a: int, b: int;
    for (a = 0, b = 10; a < b; a++, b--) {
    }
    assert(a == 5 && b == 5);

    // break only leaves the innermost loop
    local pairs: int = 0;
    for (local i: int = 0; i < 4; ++i) {
	for (local k: int = 0; k < 4; ++k) {
	    if (k > i) {
		break;
	    }
	    pairs++;
	}
    }
    assert(pairs == 10);

    // empty condition: loop until break
    local n: int = 0;
    for (;; ++n) {
	if (n == 3) {
	    break;
	}
    }
    assert(n == 3);
    return 0;
}
