include config/os

LLVM_SUPPORTED_VERSIONS := 22 21 20 19 18 17 16 15 14

ifeq ($(origin llvm-config),undefined)
    llvm-config := $(shell \
	for cmd in llvm-config llvm-config-22 llvm-config-21 \
		   llvm-config-19 llvm-config-18 llvm-config-14; do \
	    if command -v $$cmd >/dev/null 2>&1; then \
		echo $$cmd; \
		break; \
	    fi; \
	done)
endif

ifeq ($(strip $(llvm-config)),)
    $(info Specify llvm-config with: make llvm-config=<your llvm-config>)
    $(error LLVM tool llvm-config not found)
endif

llvm-config.version := $(shell $(llvm-config) --version)
llvm-config.version.major := $(firstword $(subst ., ,$(llvm-config.version)))

ifeq ($(filter $(llvm-config.version.major),$(LLVM_SUPPORTED_VERSIONS)),)
    $(error LLVM version $(llvm-config.version) is not supported. \
	    Supported major versions are: $(LLVM_SUPPORTED_VERSIONS). \
	    Please open an issue if support for this version is needed)
endif

$(info using llvm-config=$(llvm-config))
$(info using LLVM version $(llvm-config.version))

CPPFLAGS += -DLLVM_MAJOR_VERSION=$(llvm-config.version.major)

check_cxx := $(shell which $(CXX) > /dev/null; echo $$?)

ifneq ($(check_cxx),0)
    $(info C++ compiler CXX=$(CXX) was not found)
    $(info You can specify the compiler with: make CXX=<c++ compiler>)
    $(error )
endif
