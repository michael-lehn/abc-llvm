// TEST: T0180
// ARGS: -Os -O3
// FUNCTION: keep
// SIZE-ATTRIBUTES: none
// OPTIMIZED: yes
// -O3 after -Os optimizes for speed.
// The last optimization option takes precedence (regression test for #0034).

extern fn keep(x: int): int;

fn keep(x: int): int
{
    local y: int = x * 2;
    return y + 1;
}
