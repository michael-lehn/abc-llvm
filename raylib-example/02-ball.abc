@ <stdio.hdr>

@ "raylib.hdr"



//extern fn DrawCircleV(center: double, radius: float, color: u32);

//------------------------------------------------------------------------------------
// Program main entry point
//------------------------------------------------------------------------------------
fn main()
{
    // Initialization
    //---------------------------------------------------------
    local screenWidth: int = 2 * 800;
    local screenHeight: int = 2 * 450;

    SetConfigFlags(FLAG_MSAA_4X_HINT
	| FLAG_FULLSCREEN_MODE
	| FLAG_WINDOW_HIGHDPI);
    InitWindow(screenWidth, screenHeight,
	       "raylib [shapes] example - bouncing ball");

    screenWidth = GetScreenWidth() - 150;
    screenHeight = GetScreenHeight();

    local ballPosition: Vector2 = { screenWidth/2.0,
				    screenHeight/2.0 };
    local ballSpeed: Vector2 = { 5.0, 4.0 };
    local ballRadius: float = 20;
    local gravity: float = 0.2;

    local useGravity: bool = true;
    local pause: bool = false;
    local framesCounter: int = 0;

    SetTargetFPS(60);               // Set our game to run at 60 frames-per-second
    //----------------------------------------------------------

    // Main game loop
    while (!WindowShouldClose()) {   // Detect window close button or ESC key
        // Update
        //-----------------------------------------------------
	local key: int = GetKeyPressed();
	if (key) {
	    printf("key pressed = %d\n", key);
	}
        if (IsKeyPressed(KEY_G)) {
	    useGravity = !useGravity;
	    printf("useGravity changed to %d\n", useGravity);
	}
        if (IsKeyPressed(KEY_SPACE)) {
	    pause = !pause;
	    printf("pause changed to %d\n", pause);
	}

        if (!pause) {
            ballPosition.x += ballSpeed.x;
            ballPosition.y += ballSpeed.y;

            if (useGravity) {
		ballSpeed.y += gravity;
	    }

            // Check walls collision for bouncing
	    if (ballPosition.x >= screenWidth - ballRadius) {
		ballSpeed.x *= -1.0;
		ballPosition.x = 2 * (screenWidth - ballRadius)
				- ballPosition.x;
	    }

	    if (ballPosition.x <= ballRadius) {
		ballSpeed.x *= -1.0;
		ballPosition.x =
		    2 * ballRadius - ballPosition.x;
	    }

	    if (ballPosition.y >= screenHeight - ballRadius) {
		// ballSpeed.y *= -0.95float;
		ballSpeed.y *= -0.95;
		ballPosition.y = 2 * (screenHeight - ballRadius)
				- ballPosition.y;
	    }

	    if (ballPosition.y <= ballRadius) {
		ballSpeed.y *= -0.95;
		ballPosition.y = 2 * ballRadius - ballPosition.y;
	    }
        }
        else {
	    framesCounter++;
	}
        //-----------------------------------------------------

        // Draw
        //-----------------------------------------------------
        BeginDrawing();

            ClearBackground(RAYWHITE);

            DrawCircleV(ballPosition, ballRadius, MAROON);
            DrawText("PRESS SPACE to PAUSE BALL MOVEMENT",
		     10, screenHeight - 25, 20, LIGHTGRAY);

            if (useGravity) {
		DrawText("GRAVITY: ON (Press G to disable)",
			 10, screenHeight - 50, 20,
			 DARKGREEN);
            } else {
		DrawText("GRAVITY: OFF (Press G to enable)",
		10, screenHeight - 50, 20, RED);
	    }

            // On pause, we draw a blinking message
            if (pause && ((framesCounter/30)%2)) {
		DrawText("PAUSED", 350, 200, 30, GRAY);
	    }

            DrawFPS(10, 10);

        EndDrawing();
        //-----------------------------------------------------
    }

    // De-Initialization
    //---------------------------------------------------------
    CloseWindow();        // Close window and OpenGL context
    //----------------------------------------------------------
}
