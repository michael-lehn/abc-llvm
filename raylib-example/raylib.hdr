type LoadFileDataCallback: ->fn(filename: ->readonly char,
				dataSize: ->int): ->u8;
type SaveFileDataCallback: ->fn(filename: ->readonly char, data: ->void,
				dataSize: int): bool;
type LoadFileTextCallback: ->fn(filename: ->readonly char): ->readonly char;
type SaveFileTextCallback: ->fn(filename: ->readonly char,
				text: ->readonly char): bool;

