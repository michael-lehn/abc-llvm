// TEST: T0034
// if, else if and else; conditions of integer and pointer type.

fn classify(n: int): int
{
    if (n < 0) {
	return -1;
    } else if (n == 0) {
	return 0;
    } else if (n < 10) {
	return 1;
    } else {
	return 2;
    }
}

fn main(): int
{
    assert(classify(-5) == -1);
    assert(classify(0) == 0);
    assert(classify(9) == 1);
    assert(classify(10) == 2);

    local taken: int = 0;
    if (3) {
	taken = 1;
    }
    assert(taken == 1);

    local p: -> int = nullptr;
    if (p) {
	taken = 2;
    } else {
	taken = 3;
    }
    assert(taken == 3);

    // nested if without else
    if (taken == 3) {
	if (taken > 5) {
	    taken = 4;
	}
    }
    assert(taken == 3);
    return 0;
}
