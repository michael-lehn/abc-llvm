// Warning options: -Wuninitialized, -Wall
//
// x has a value if n is not zero. As this is not the case on all paths it is
// "may be used uninitialized". Try it: the output depends on the optimization
// level, which is what undefined behavior looks like.

@ <stdio.hdr>

fn sign(n: int): int
{
    local x: int;

    if (n > 0) {
	x = 1;
    } else if (n < 0) {
	x = -1;
    }
    return x; // WARNING: variable 'x' may be used uninitialized
}

fn main()
{
    printf("%d\n", sign(0));
}
