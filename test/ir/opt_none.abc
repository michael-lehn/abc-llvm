// TEST: T0171
// ARGS: -O0 -O0
// FUNCTION: keep
// SIZE-ATTRIBUTES: none
// OPTIMIZED: no
// Repeated -O0: no optimization and no size attributes.
// The last optimization option takes precedence (regression test for #0034).

extern fn keep(x: int): int;

fn keep(x: int): int
{
    local y: int = x * 2;
    return y + 1;
}
